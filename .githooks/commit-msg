#!/usr/bin/env bash
# 1Q commit-msg 钩子：强制提交标题符合 Conventional Commits。
#
# 与 pre-commit 分工——pre-commit 管提交内容（UTF-8 BOM、major 级门禁），
# 本钩子管提交信息格式。规则只在这里、只在违规时出现，CLAUDE.md 不再重复。
#
# 放行的例外：
#   - merge 提交（标题由 git 生成，不受本规则约束）
#   - `git revert` 生成的 `Revert "..."` 标题
#   - autosquash 标记 `fixup!` / `squash!`（后续 rebase 时会重写标题）
set -euo pipefail

msg_file="${1:-}"
[[ -n "${msg_file}" && -f "${msg_file}" ]] || exit 0

# 标题 = 第一条非注释、非空行。
subject="$(grep -v '^#' "${msg_file}" | sed '/^[[:space:]]*$/d' | head -n 1 || true)"
# 空标题（如 `git commit --amend` 未改动）交由 git 自身处理，不在本钩子拦截。
[[ -n "${subject}" ]] || exit 0

case "${subject}" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if printf '%s' "${subject}" | grep -Eq '^(feat|fix|refactor|test|docs|chore|perf)(\([^)]+\))?!?: .+'; then
  exit 0
fi

cat >&2 <<EOF
[commit-msg] 提交标题不符合 Conventional Commits：

    ${subject}

正确格式： type(scope): description
  type  ∈ feat | fix | refactor | test | docs | chore | perf
  scope = 主要模块或域（例 airborne_radar、sar、fusion、common、docs、examples）
  描述  = 祈使句、小写开头；括号内可列关键新符号，便于按符号检索历史

示例：
  fix(fusion): preserve first-sample bearing update in track initialization
  docs(common): freeze rule 14 ownership of the validation layer
EOF
exit 1
