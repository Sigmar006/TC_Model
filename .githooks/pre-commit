#!/usr/bin/env bash
# 1Q pre-commit 钩子（经 core.hooksPath=.githooks 激活，activate 脚本自动配置）：
# 暂存区 C/C++ 文件缺 UTF-8 BOM 时自动补齐并重新暂存（VS2015 交付要求）。
# 存在分块暂存（暂存内容 ≠ 工作区）时拒绝自动补齐，避免夹带未暂存改动。
# merge 提交跳过。
# 不再在 main/master 上自动开 feature/auto-*：合入走 --no-ff，过程分支由调用方删除。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# merge 进行中 MERGE_HEAD 存在：跳过。
_merge_head="$(git rev-parse --git-path MERGE_HEAD)"
[[ -f "${_merge_head}" ]] && exit 0

# ---------- BOM 自动补齐 ----------
# 扩展名口径与 scripts/utf8_bom.py 的 SOURCE_EXTENSIONS 一致（仅 C/C++；shell 等
# 带 BOM 会破坏 shebang，不碰）。
_bom_fixed=0
_bom_blocked=()
while IFS= read -r -d '' f; do
  case "$f" in
    *.h|*.hh|*.hpp|*.hxx|*.ipp|*.inl|*.c|*.cc|*.cpp|*.cxx) ;;
    *) continue ;;
  esac
  [[ -f "$f" ]] || continue
  if head -c 3 -- "$f" | cmp -s - <(printf '\xef\xbb\xbf'); then
    continue
  fi
  _staged="$(git show ":$f" 2>/dev/null | git hash-object --stdin || true)"
  _worktree="$(git hash-object -- "$f")"
  if [[ "$_staged" != "$_worktree" ]]; then
    _bom_blocked+=("$f")
    continue
  fi
  printf '\xef\xbb\xbf' | cat - "$f" > "$f.__bom_tmp" && mv "$f.__bom_tmp" "$f"
  git add -- "$f"
  _bom_fixed=$((_bom_fixed + 1))
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if (( ${#_bom_blocked[@]} > 0 )); then
  echo "[pre-commit] 以下 C/C++ 文件缺 UTF-8 BOM，且暂存内容与工作区不一致（分块暂存），" >&2
  echo "             无法自动补齐（会夹带未暂存改动）：" >&2
  printf '  %s\n' "${_bom_blocked[@]}" >&2
  echo "  处理：完整暂存后重试，或手动 scripts/utf8_bom.py convert。" >&2
  exit 1
fi
if (( _bom_fixed > 0 )); then
  echo "[pre-commit] 已为 ${_bom_fixed} 个 C/C++ 文件自动补 UTF-8 BOM 并重新暂存"
fi

exit 0
