# macOS
.DS_Store

# 库默认日志目录（ONEQ_LOG_DIR 为空时落到进程 CWD/log/）
/log/

# Windows 内置文件日志后端（ProjectFileLog，ONEQ_ENABLE_FILE_LOG）运行产物
1q_library.log

# 分层验收日志运行产物（ONEQ_ENABLE_*_ACCEPTANCE_LOG）
opir_acceptance.log
rir_acceptance.log
fusion_acceptance.log
inference_acceptance.log
precision_acceptance.log
rir_antenna_pattern.csv
rir_scan_pattern.csv

# Build outputs
build/
out/
# LLVM source-based coverage 运行时产物（*.profraw / *.profdata）。
# build/ 已覆盖构建目录内的，这两条兜底捕获在仓库根散落的——
# 当 ENABLE_EXAMPLES=ON 后直接运行带插桩的 example 二进制时会在 CWD 写出。
*.profraw
*.profdata

# CMake local/user files
CMakeUserPresets.json
.cmake/CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
Testing/

# Conan local cache in workspace
.cache/

# VS Code local settings（settings.json 为仓库共享配置：默认终端 Git Bash + utf8bom）
.vscode/*
!.vscode/settings.json
imgui.ini

# Local documentation scratch space
doc/
docs/local/
docs/tmp/

# Planning workspace (not tracked)
plan/

# Engineering planning artifacts (not tracked)
task_plan.md
findings.md
progress.md

# Remember plugin workspace (not tracked)
.remember/

# project prompts (local AI agent configs, not for version control)
# 例外：.github/workflows/ 是 CI 配置，必须纳入版本控制。
GEMINI.md
# CLAUDE.md 作为 prompt 单一事实源纳入版本控制；AGENTS.md 为指向它的符号链接。
.claude/skills/debug-cpp-bug/
# 符号链接目录：实际文件在 .claude/skills/，以下目录仅为各 agent 发现用
.agents/skills/
.zcode/
# 多 harness 本地配置目录：.claude 纳入版本控制，其余本地忽略
.codex/
.cursor/
.gemini/
# 忽略 .github/ 下除 workflows/ 外的本地配置
.github/*
!.github/workflows/

# JSBSim output side effects
JSBout*.csv

# Binary artifacts
*.o
*.obj
*.a
*.so
*.dylib
*.dll
*.exe

# Vendored third-party dependencies
third_party/

# FlatBuffers 构建期生成的 replay 头（由 flatc 从 schemas/replay/*.fbs 产生，
# 见 cmake/FeatureFlatBuffers.cmake。不再手工提交，防止 schema 与生成头漂移。）
src/*/session/generated/*_generated.h

# Local analysis artifacts
jsbsim_aircraft_analysis.md

# Submodules or embedded repos
src/airborne_radar/signal/Stone-Soup/
.claude/worktrees/
.venv/

# Tool-generated session continuation cache (not tracked)
.omo/
.zcode/

# CodeGraph 索引数据（工具生成、随机器本地，不纳入版本控制）
.codegraph/

# Local working documents (not tracked)
Work/

# Local machine Git Bash overrides (ONEQ_CMAKE_ROOT, etc.)
scripts/1q_env.local.sh

# 示例运行时日志/CSV/验收文件产物（统一默认输出目录 examples/log/）
examples/log/

# python bytecode
__pycache__/
*.pyc
