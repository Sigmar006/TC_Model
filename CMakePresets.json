{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/install/${presetName}",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_SUPPRESS_REGENERATION": "ON"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "vendor": {
                "apple.com/Xcode/CMake/1.0": {
                    "hostOS": [
                        "macOS"
                    ]
                }
            },
            "generator": "Ninja",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan"
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Debug",
            "description": "Daily macOS debugging; JSBSim-linked tests run ~6x slower than release",
            "binaryDir": "${sourceDir}/build/llvm-ninja-debug-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/llvm-ninja-debug-local/build/Debug/generators/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "ENABLE_INSTALL": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "llvm-ninja-coverage",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Coverage (source-based)",
            "description": "Source-based coverage; drive tests via tools/coverage_report.sh only, never ctest by hand",
            "binaryDir": "${sourceDir}/build/llvm-ninja-coverage-local",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/llvm-ninja-coverage-local/build/Debug/generators/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "ENABLE_TESTING": "ON",
                "ENABLE_INSTALL": "ON",
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_COVERAGE": "ON"
            }
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "macos-base",
            "displayName": "macOS LLVM Ninja Release",
            "description": "macOS daily-dev default — preferred over debug (JSBSim ~6x faster)",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/llvm-ninja-release/build/Release/generators/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "ENABLE_TESTING": "ON",
                "ENABLE_INSTALL": "ON",
                "BUILD_SHARED_LIBS": "OFF"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "conan",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/build/${presetName}/build/generators/conan_toolchain.cmake",
                "ENABLE_PCH": "ON"
            }
        },
        {
            "name": "VisualStudio.14.0-amd64",
            "displayName": "Visual Studio 14 2015 (x64, Conan)",
            "description": "VS2015 x64 via Conan toolchain",
            "inherits": "windows-base",
            "generator": "Visual Studio 14 2015",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "11",
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_INSTALL": "ON"
            }
        },
        {
            "name": "1q_log_vs2015",
            "displayName": "1q acceptance logs (VS2015 x64, no Conan)",
            "description": "VisualStudio.14.0-amd64-none variant with all five per-layer acceptance files ON by default (sbirs/rir/fusion/inference/precision_acceptance.log; docs/review/acceptance_item_catalog_2026-08-22.md). Run scripts/win/fetch_third_party.bat first. VS2015+Conan is not viable on this machine: CMake 4.3.1 emits v145 toolset requirements that MSBuild v140 cannot satisfy (flatbuffers recipe build fails).",
            "inherits": "VisualStudio.14.0-amd64-none",
            "cacheVariables": {
                "ONEQ_ENABLE_OPIR_ACCEPTANCE_LOG": "ON",
                "ONEQ_ENABLE_RIR_ACCEPTANCE_LOG": "ON",
                "ONEQ_ENABLE_FUSION_ACCEPTANCE_LOG": "ON",
                "ONEQ_ENABLE_INFERENCE_ACCEPTANCE_LOG": "ON",
                "ONEQ_ENABLE_PRECISION_EVALUATION_LOG": "ON"
            }
        },
        {
            "name": "VisualStudio.15.0-amd64",
            "displayName": "VS2026 + v141 (VS2017-era toolset, x64, Conan)",
            "description": "VS2026 generator with v141 (14.16.27023) toolset via Conan.",
            "inherits": "windows-base",
            "generator": "Visual Studio 18 2026",
            "toolset": "v141",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "17",
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_TESTING": "ON",
                "ENABLE_INSTALL": "ON"
            }
        },
        {
            "name": "windows-base-none",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "toolset": "host=x64",
            "architecture": "x64",
            "cacheVariables": {
                "PACKAGE_MANAGER": "none",
                "ENABLE_PCH": "ON"
            }
        },
        {
            "name": "VisualStudio.14.0-amd64-none",
            "displayName": "Visual Studio 14 2015 (x64, no Conan)",
            "description": "VS2015 x64 without Conan: run scripts/win/fetch_third_party.bat first to git clone deps into third_party/, consumed by VendorPackages.cmake",
            "inherits": "windows-base-none",
            "generator": "Visual Studio 14 2015",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "11",
                "BUILD_SHARED_LIBS": "OFF",
                "ENABLE_TESTING": "OFF",
                "ENABLE_INSTALL": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-build-base",
            "hidden": true,
            "jobs": 4
        },
        {
            "name": "llvm-ninja-debug",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-coverage",
            "configurePreset": "llvm-ninja-coverage"
        },
        {
            "name": "llvm-ninja-release",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "VisualStudio.14.0-amd64-debug",
            "displayName": "Visual Studio 14 2015 (x64) - Debug",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.14.0-amd64",
            "configuration": "Debug"
        },
        {
            "name": "VisualStudio.14.0-amd64-release",
            "displayName": "Visual Studio 14 2015 (x64) - Release",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.14.0-amd64",
            "configuration": "Release"
        },
        {
            "name": "1q_log_vs2015-debug",
            "displayName": "1q acceptance logs (VS2015 x64) - Debug",
            "inherits": "windows-build-base",
            "configurePreset": "1q_log_vs2015",
            "configuration": "Debug"
        },
        {
            "name": "1q_log_vs2015-release",
            "displayName": "1q acceptance logs (VS2015 x64) - Release",
            "inherits": "windows-build-base",
            "configurePreset": "1q_log_vs2015",
            "configuration": "Release"
        },
        {
            "name": "VisualStudio.14.0-amd64-none-debug",
            "displayName": "Visual Studio 14 2015 (x64, no Conan) - Debug",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.14.0-amd64-none",
            "configuration": "Debug"
        },
        {
            "name": "VisualStudio.14.0-amd64-none-release",
            "displayName": "Visual Studio 14 2015 (x64, no Conan) - Release",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.14.0-amd64-none",
            "configuration": "Release"
        },
        {
            "name": "VisualStudio.15.0-amd64-debug",
            "displayName": "VS2026 v141 (VS2017-era) - Debug",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.15.0-amd64",
            "configuration": "Debug"
        },
        {
            "name": "VisualStudio.15.0-amd64-release",
            "displayName": "VS2026 v141 (VS2017-era) - Release",
            "inherits": "windows-build-base",
            "configurePreset": "VisualStudio.15.0-amd64",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "stopOnFailure": false
            }
        },
        {
            "name": "llvm-ninja-debug",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-debug"
        },
        {
            "name": "llvm-ninja-coverage",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-coverage"
        },
        {
            "name": "llvm-ninja-release",
            "inherits": "test-base",
            "configurePreset": "llvm-ninja-release"
        },
        {
            "name": "VisualStudio.15.0-amd64-debug",
            "inherits": "test-base",
            "configurePreset": "VisualStudio.15.0-amd64",
            "configuration": "Debug"
        },
        {
            "name": "VisualStudio.15.0-amd64-release",
            "inherits": "test-base",
            "configurePreset": "VisualStudio.15.0-amd64",
            "configuration": "Release"
        }
    ]
}
