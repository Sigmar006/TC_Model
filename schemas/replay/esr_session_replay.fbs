// esr_session_replay.fbs
// ESR 模块 replay FlatBuffers schema：session_config 与 runtime_config_patch 载荷
//
// file_identifier: ESRT (ESR Session)

namespace esr.replay;

// ---- EsrSessionConfig ----

table EsrTuningWindow {
  center_frequency_hz: double;
  bandwidth_hz: double;
  dwell_cycles: uint32 = 1;
}

table EsrCoSiteIsolationPath {
  transmitter_sensor_entity_id: uint;
  isolation_db: double;
}

table EsrHardwareConfig {
  receiver_band_lower_hz:      double;
  receiver_band_upper_hz:      double;
  receiver_sensitivity_w:      float;
  receiver_noise_figure_db:    float = 5.0;
  receiver_reference_temperature_k: float = 290.0;
  integrated_receive_loss_db:  float;
  beam_az_width_deg:           float;
  beam_el_width_deg:           float;
  az_scan_range_deg:           float;
  el_scan_range_deg:           float;
  antenna_peak_gain_dbi:       float = 0.0;
  antenna_sidelobe_level_db:   float = -30.0;
  antenna_backlobe_level_db:   float = -40.0;
  polarization:                int32 = 4;
  cross_polarization_isolation_db: float = 20.0;
  minimum_far_field_range_m:   float = 1.0;
  co_site_paths:               [EsrCoSiteIsolationPath];
  maximum_linear_input_power_w: float = 0.001;
  tuning_plan:                 [EsrTuningWindow];
}

table EsrOrientationConfig {
  antenna_mount_az_deg: float;
  antenna_mount_el_deg: float;
}

table EsrScanConfig {
  scan_center_az_deg:     float;
  scan_center_el_deg:     float;
  scan_rate_hz:           float;
  scan_start_position:    int32;
  scan_sequence:          int32;
  use_explicit_scan_bounds: bool;
  scan_start_az_deg:      float;
  scan_end_az_deg:        float;
  scan_start_el_deg:      float;
  scan_end_el_deg:        float;
}

table EsrMissionConfig {
  work_mode: int32;
  scan:      EsrScanConfig;
}

table EsrPolicyConfig {
  detection_profile:          int32;
  use_profile_defaults:       bool;
  minimum_snr_db:          float;
  pfa:                        float;
  pulse_count:                uint32;
  threshold_scale:            float;
  enable_statistical_detection: bool;
}

table EsrAtmosphericPhysicsConfig {
  enable_physical_model: bool;
  pressure_hpa:          float;
  temperature_k:         float;
  relative_humidity:     float;
}

table EsrAtmosphericObservation {
  precipitation_rate_mmph:  float;
  visibility_km:            float;
}

table EsrEnvironmentConfig {
  preset:                   int32;
  atmospheric_physics:      EsrAtmosphericPhysicsConfig;
  propagation_profile:      int32;
  clutter_density:          int32;
  spectrum_occupancy_ratio: float;
  atmospheric_observation:  EsrAtmosphericObservation;
}

table EsrSessionConfig {
  hardware:       EsrHardwareConfig;
  mission:        EsrMissionConfig;
  orientation:    EsrOrientationConfig;
  policy:         EsrPolicyConfig;
  environment:    EsrEnvironmentConfig;
  sensor_enabled: bool = true;
}

root_type EsrSessionConfig;
file_identifier "ESRT";

// ---- EsrRuntimeConfigPatch ----

table EsrEnvironmentRuntimeConfigPatch {
  has_atmospheric_physics:      bool;
  atmospheric_physics:          EsrAtmosphericPhysicsConfig;
  has_propagation_profile:      bool;
  propagation_profile:          int32;
  has_clutter_density:          bool;
  clutter_density:              int32;
  has_spectrum_occupancy_ratio: bool;
  spectrum_occupancy_ratio:     float;
  has_atmospheric_observation:  bool;
  atmospheric_observation:      EsrAtmosphericObservation;
}

table EsrRuntimeConfigPatch {
  has_sensor_enabled:          bool;
  sensor_enabled:              bool;
  has_work_mode:               bool;
  work_mode:                   int32;
  has_scan_rate_hz:            bool;
  scan_rate_hz:                float;
  has_scan_start_position:     bool;
  scan_start_position:         int32;
  has_scan_sequence:           bool;
  scan_sequence:               int32;
  has_scan_center_az_deg:      bool;
  scan_center_az_deg:          float;
  has_scan_center_el_deg:      bool;
  scan_center_el_deg:          float;
  has_use_explicit_scan_bounds: bool;
  use_explicit_scan_bounds:    bool;
  has_scan_start_az_deg:       bool;
  scan_start_az_deg:           float;
  has_scan_end_az_deg:         bool;
  scan_end_az_deg:             float;
  has_scan_start_el_deg:       bool;
  scan_start_el_deg:           float;
  has_scan_end_el_deg:         bool;
  scan_end_el_deg:             float;
  has_mission:                 bool;
  mission:                     EsrMissionConfig;
  has_policy:                  bool;
  policy:                      EsrPolicyConfig;
  has_environment: bool;
  environment:  EsrEnvironmentRuntimeConfigPatch;
}

table EsrRuntimeConfigApplyResult {
  status:               int32;
  has_requested_update: bool;
  applied:              bool;
}

table EsrRuntimeConfigPatchEvent {
  patch_payload: [ubyte];
  result:        EsrRuntimeConfigApplyResult;
}
