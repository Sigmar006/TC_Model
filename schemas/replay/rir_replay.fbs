// RIR 单周期 replay 记录 schema。
// 阶段 1 V1 镜像 AR 识别表；阶段 2-S 破坏性版本 V2：
//   - 航迹语义内化（自持跟踪，不再回放外部供给字段）；
//   - 识别效能摘要增加驻留预算；
//   - 会话状态增加检测随机种子。
// Stage B 双产品加性扩展（2026-08-18）：输出帧加特征量测向量（出口①）、
//   结果表加航迹归属向量——V2 表加可选字段，root_type 与 "RIR2" 标识不变，
//   旧记录缺新字段时解码为空值（flatbuffers 加性规则）。
// RF 物理链加性扩展（2026-08-19）：RirCycleResultV2 加 emission_frame（本周期
//   实际 RIR 发射；旧记录缺字段时解码为空帧）。
// 指定任务回退成因加性扩展（2026-08-21）：designation_revert_reason 新增
//   kOutsideSteerableVolume=3（int 字段；旧记录不受影响）。
// V2 为历史版本；V1 保留仅用于旧记录识别与显式拒绝。
// 破坏性版本 V3（2026-09-03，极化四类判决）：极化样本从 dBsm+has_* 双通道口径
//   替换为四路复数 RirPolSMatrixSample（HH/HV/VH/VV 幅度+相位，窗口语义）；
//   RirSceneTarget 向量字段改型、识别结果表加 ballistic_subclass。嵌套表字段
//   布局变更导致旧 RIR2 记录不可安全解码——root 升 V3、"RIR3" 标识，旧录制
//   显式拒绝（沿 V1→V2 先例）。

namespace oneq.replay.remote_identification_radar.fb;

// RF scene v2 replay payloads（与 airborne_radar_replay.fbs 字段对齐；RIR 独立 schema 副本）。
table Vector3d { x:double; y:double; z:double; }
table RfSceneDirectionV2 { x:double; y:double; z:double; }
table RfSceneAntennaPatternV2 {
  boresight_ecef:RfSceneDirectionV2;
  peak_gain_dbi:double;
  half_power_beamwidth_deg:double;
  sidelobe_level_db:double;
  backlobe_level_db:double;
  cross_polarization_isolation_db:double;
}
table RfEmissionIdentityV2 {
  sensor_entity_id:uint;
  emission_id:ulong;
}
table RfWaveformScheduleV2 {
  kind:int;
  activity_start_time_s:double;
  activity_duration_s:double;
  center_frequency_hz:double;
  occupied_bandwidth_hz:double;
  transmit_power_w:double;
  pulse_width_s:double;
  pulse_repetition_interval_s:double;
  first_pulse_time_s:double;
  pulse_count:uint;
  pulse_jitter_fraction:double;
  timing_seed:ulong;
  timing_epoch:ulong;
  sweep_start_frequency_hz:double;
  sweep_stop_frequency_hz:double;
  sweep_period_s:double;
}
table RfSceneEmissionV2 {
  identity:RfEmissionIdentityV2;
  position_ecef_m:Vector3d;
  velocity_ecef_mps:Vector3d;
  antenna:RfSceneAntennaPatternV2;
  polarization:int;
  waveform:RfWaveformScheduleV2;
}
table RfSceneFrameV2 {
  world_cycle_index:ulong;
  window_start_time_s:double;
  window_duration_s:double;
  emissions:[RfSceneEmissionV2];
}

table RirRecognitionResultV1 {
  state:int;
  target_category:int;
  target_model:string;
  confidence:float;
  best_score:float;
  runner_up_score:float;
  rcs_similarity:float;
  rcs_quality:float;
  motion_similarity:float;
  motion_quality:float;
  polarization_similarity:float;
  polarization_quality:float;
  range_profile_similarity:float;
  range_profile_quality:float;
  valid_feature_mask:ubyte;
  observation_count:uint;
  accumulation_sec:float;
  database_version:string;
  source_cycle_index:uint;
  source_batch_id:ulong;
  ballistic_subclass:int;  // RirBallisticSubclass（0-4）；判据未冻结恒 0
}

table RirTrackRecognitionOutputV1 {
  association_key:ulong;
  result:RirRecognitionResultV1;
}

// ===== Stage B 双产品加性扩展（2026-08-18；RIR2 标识不变，旧记录缺字段解码为空）=====

table RirRcsFeatureObservationV1 {
  valid:bool;
  mean_dbsm:float;
  std_db:float;
  azimuth_variation_db:float;
  elevation_variation_db:float;
  peak_to_valley_db:float;
  aspect_coverage_deg:float;
  quality:float;
}

table RirMotionFeatureObservationV1 {
  valid:bool;
  speed_m_per_s:float;
  altitude_m:float;
  acceleration_m_per_s2:float;
  turn_radius_m:float;
  is_straight:bool;
  quality:float;
}

table RirPolarizationFeatureObservationV1 {
  valid:bool;
  energy_difference_db:float;
  relative_difference_db:float;
  energy_sum_db:float;
  quality:float;
}

table RirRangeProfileFeatureObservationV1 {
  valid:bool;
  length_m:float;
  peak_count:uint;
  peak_energy_concentration:float;
  resolution_m:float;
  quality:float;
}

table RirPolarizationStatsObservationV1 {
  valid:bool;
  determinant_mean:float; determinant_std:float;
  span_mean:float; span_std:float;
  depolarization_mean:float; depolarization_std:float;
  psi_mean_deg:float; psi_std_deg:float;
  tau_mean_deg:float; tau_std_deg:float;
}

table RirFeatureMeasurementRecordV1 {
  association_key:ulong;
  rcs:RirRcsFeatureObservationV1;
  motion:RirMotionFeatureObservationV1;
  polarization:RirPolarizationFeatureObservationV1;
  range_profile:RirRangeProfileFeatureObservationV1;
  polarization_stats:RirPolarizationStatsObservationV1;  // 加性（RIR3，2026-09-03）
  valid_feature_mask:ubyte;
  look_az_deg:float;
  look_el_deg:float;
  range_m:float;
  snr_db:float;
  dwell_sec:float;
  bandwidth_hz:float;
  has_platform_position:bool;
  platform_position_x_m:double;
  platform_position_y_m:double;
  platform_position_z_m:double;
  cycle_index:uint;
  batch_id:ulong;
}

table RirOutputFrameV1 {
  input_cycle_index:uint;
  batch_id:ulong;
  recognition_outputs:[RirTrackRecognitionOutputV1];
  feature_measurements:[RirFeatureMeasurementRecordV1];
}

table RirRecognitionCycleSummaryV1 {
  participating_track_count:uint;
  category_confirmed_count:uint;
  model_confirmed_count:uint;
  unknown_count:uint;
  disabled_count:uint;
  rcs_availability_rate:float;
  motion_availability_rate:float;
  polarization_availability_rate:float;
  range_profile_availability_rate:float;
  mean_confidence:float;
  mean_first_confirmation_sec:float;
  has_ground_truth:bool;
  category_accuracy:float;
  model_accuracy:float;
}

table RirCycleResultV1 {
  input_cycle_index:uint;
  status:int;
  abort_reason:int;
  output_frame:RirOutputFrameV1;
  has_recognition_summary:bool;
  recognition_summary:RirRecognitionCycleSummaryV1;
}

table RirSessionReplayStateV1 {
  active_database_version:string;
}

table RirCycleReplayRecordV1 {
  result:RirCycleResultV1;
  session_state:RirSessionReplayStateV1;
}

// root_type 见文末 V2；V1 表保留供旧记录显式拒绝路径校验。


// ===== 阶段 2-S V2（破坏性版本）=====

table RirDwellBudgetSummaryV2 {
  scheduled_dwell_count:uint;
  executed_dwell_count:uint;
  dwell_budget_sec:float;
  dwell_consumed_sec:float;
}

table RirRecognitionCycleSummaryV2 {
  participating_track_count:uint;
  category_confirmed_count:uint;
  model_confirmed_count:uint;
  unknown_count:uint;
  disabled_count:uint;
  rcs_availability_rate:float;
  motion_availability_rate:float;
  polarization_availability_rate:float;
  range_profile_availability_rate:float;
  mean_confidence:float;
  mean_first_confirmation_sec:float;
  has_ground_truth:bool;
  category_accuracy:float;
  model_accuracy:float;
  dwell_budget:RirDwellBudgetSummaryV2;
}

table RirTrackAttributionRecordV2 {
  association_key:ulong;
  external_target_id:ulong;
  target_name:string;
  hit_count:uint;
  position_enu_x_m:double;
  position_enu_y_m:double;
  position_enu_z_m:double;
  speed_m_per_s:double;
  track_status:ubyte = 0;  // RirTrackLifecycleStatus（加性，默认 kTentative）
}

table RirCycleResultV2 {
  input_cycle_index:uint;
  status:int;
  abort_reason:int;
  output_frame:RirOutputFrameV1;
  has_recognition_summary:bool;
  recognition_summary:RirRecognitionCycleSummaryV2;
  designated_target_id:ulong = 0;
  designation_active:bool = false;
  designation_reverted_to_scan:bool = false;
  designation_revert_reason:int = 0;
  dwell_center_az_deg:float = 0.0;
  dwell_center_el_deg:float = 0.0;
  track_attributions:[RirTrackAttributionRecordV2];
  emission_frame:RfSceneFrameV2;
}

table RirSessionReplayStateV2 {
  active_database_version:string;
  detection_random_seed:uint;
}

table RirCycleReplayRecordV2 {
  result:RirCycleResultV2;
  session_state:RirSessionReplayStateV2;
}

table RirCycleReplayRecordV3 {
  result:RirCycleResultV2;
  session_state:RirSessionReplayStateV2;
}

root_type RirCycleReplayRecordV3;
file_identifier "RIR4";

// ===== 周期输入载荷（cycle_input 事件；2026-08-23）=====
// 与 include/1q/remote_identification_radar/session/RirSceneTypes.h 及
// RirCycleInput.h 字段一一对应。RirCycleInput 不是本 schema 的 root_type：
// 编码时不写 file_identifier，解码侧用 GetRoot<RirCycleInput> + Verifier 校验
// （与 EOS/SAR 同口径），root_type 与 "RIR2" 标识保持不变。

table RirAspectRcsSample {
  aspect_az_deg:float;
  aspect_el_deg:float;
  rcs_dbsm:float;
}

table RirPolSMatrixSample {
  aspect_az_deg:float;
  aspect_el_deg:float;
  hh_amp_db:float;
  hh_phase_deg:float;
  hv_amp_db:float;
  hv_phase_deg:float;
  vh_amp_db:float;
  vh_phase_deg:float;
  vv_amp_db:float;
  vv_phase_deg:float;
}

table RirRangeRcsScatterer {
  range_offset_m:float;
  rcs_dbsm:float;
  channel_1_rcs_dbsm:float;
  channel_2_rcs_dbsm:float;
  phase_deg:float;
  fluctuation_std_db:float;
}

table RirSceneTarget {
  external_target_id:ulong;
  target_name:string;
  position_x:float;
  position_y:float;
  position_z:float;
  velocity_x:float;
  velocity_y:float;
  velocity_z:float;
  rcs:float;
  target_swerling_type:ubyte;  // RirSwerlingType（0-4）
  aspect_rcs_samples:[RirAspectRcsSample];
  polarization_samples:[RirPolSMatrixSample];
  range_rcs_scatterers:[RirRangeRcsScatterer];
}

table RirCycleInput {
  input_cycle_index:uint;
  dt_sec:double;
  sim_time_sec:float;
  platform_position:Vector3d;
  scene_targets:[RirSceneTarget];
  rf_scene:RfSceneFrameV2;
}
