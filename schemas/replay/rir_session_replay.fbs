// rir_session_replay.fbs
// RIR 模块 replay FlatBuffers schema：session_config、runtime_config_patch 与
// failure_marker 载荷。字段与以下公开头一一对应（新增公开配置字段必须同步扩展）：
//   include/1q/remote_identification_radar/config/RirSessionConfig.h
//   include/1q/remote_identification_radar/config/RirHardwareConfig.h
//   include/1q/remote_identification_radar/config/RirOrientationConfig.h
//   include/1q/remote_identification_radar/config/RirMissionConfig.h
//   include/1q/remote_identification_radar/config/RirPolicyConfig.h
//   include/1q/remote_identification_radar/config/RirEnvironmentConfig.h
//   include/1q/remote_identification_radar/config/RirRuntimeConfigPatch.h
// 所有标量字段使用 schema 默认值 0/false，编码侧总是写入真实值：解码后与 C++
// 结构体默认值无关，回放建会话与录制会话逐字段一致。
//
// file_identifier: RIRF (RIR Config)

namespace oneq.replay.remote_identification_radar.session.fb;

// ---- 公共几何/角度 ----

table RirAzimuthElevationDeg {
  az_deg:float;
  el_deg:float;
}

table RirAzimuthElevationLimitsDeg {
  az_min_deg:float;
  az_max_deg:float;
  el_min_deg:float;
  el_max_deg:float;
}

// ---- hardware 域 ----

table RirTransmitterConfig {
  peak_power_w:float;
  frequency_hz:float;
  bandwidth_hz:float;
  pulse_width_s:float;
  prf_hz:float;
  transmit_loss_db:float;
}

table RirAntennaConfig {
  main_beam_gain_db:float;
  nominal_az_beamwidth_deg:float;
  nominal_el_beamwidth_deg:float;
  antenna_length_m:float;
  antenna_width_m:float;
  model_type:int;  // RirAntennaPatternModelType
  max_sidelobe_level_db:float;
  backlobe_level_db:float;
  scan_loss_coeff_db_per_deg2:float;
  max_scan_loss_db:float;
  boresight_offset_deg:RirAzimuthElevationDeg;
}

table RirReceiverConfig {
  noise_figure_db:float;
  receive_loss_db:float;
  cross_polarization_isolation_db:float;
  maximum_linear_input_power_w:float;
  scene_polarization:int;  // oneq::electromagnetics::RfScenePolarization
}

table RirRcsPhysicsConfig {
  enable_physical_rcs:bool;
  physics_mix_ratio:float;
  cylinder_weight:float;
  min_equivalent_radius_m:float;
  max_equivalent_radius_m:float;
  min_rcs_m2:float;
  max_rcs_m2:float;
  bistatic_psi_offset_deg:float;
}

table RirSignalProcessingConfig {
  target_processing_gain_db:float;
  noise_processing_gain_db:float;
  clutter_suppression_gain_db:float;
  jamming_suppression_gain_db:float;
}

table RirHardwareConfig {
  transmitter:RirTransmitterConfig;
  antenna:RirAntennaConfig;
  receiver:RirReceiverConfig;
  rcs_physics:RirRcsPhysicsConfig;
  signal_processing:RirSignalProcessingConfig;
}

// ---- orientation 域 ----
// 直接为可扫描体积限位（阵面相对 az、绝对 el）；无额外外壳表。

// ---- mission 域 ----

table RirMissionConfig {
  work_mode:int;  // RirWorkMode
  scan_center_deg:RirAzimuthElevationDeg;
  max_range_m:float;
  recognition_dwell_sec:float;
  scan_start_position:int;  // oneq::foundation::ScanStartPosition
  scan_sequence:int;        // oneq::foundation::ScanSequence
  step_scale:float;
  scan_window_deg:RirAzimuthElevationLimitsDeg;  // 任务扫描子窗（缺省无界=不收窄）
}

// ---- policy 域 ----

table RirDetectionPolicyConfig {
  cfar_pfa:float;
  min_snr_db:float;
  min_detection_margin_db:float;
  pulse_count:int;
  random_seed:uint;
  gate_mode:int;  // RirDetectionGateMode
}

table RirAssociationPolicyConfig {
  distance_gate_sigma:float;
}

table RirTrackingPolicyConfig {
  kalman_noise_diff_coeff:float;
}

table RirLifecyclePolicyConfig {
  confirm_hits:uint;
  max_miss_before_lost:uint;
  max_lost_cycles:uint;
  enable_imm_lifecycle:bool;
  model_count_hint:uint;
}

table RirRecognitionFeatureWeights {
  rcs_weight:float;
  motion_weight:float;
  polarization_weight:float;
  range_profile_weight:float;
}

table RirRecognitionPolicy {
  enabled:bool;
  min_confirmed_hits:uint;
  accumulation_window_sec:float;
  min_observation_count:uint;
  acceptance_score:float;
  minimum_margin:float;
  result_hold_sec:float;
  feature_weights:RirRecognitionFeatureWeights;
  database_path:string;
}

table RirPolicyConfig {
  detection:RirDetectionPolicyConfig;
  association:RirAssociationPolicyConfig;
  tracking:RirTrackingPolicyConfig;
  lifecycle:RirLifecyclePolicyConfig;
  recognition:RirRecognitionPolicy;
}

// ---- environment 域 ----

table RirAtmosphericObservation {
  enable_physical_model:bool;
  pressure_hpa:float;
  temperature_k:float;
  relative_humidity:float;
}

table RirEnvironmentConfig {
  weather_attenuation_db:float;
  vegetation_cover_profile:int;  // RirVegetationCoverProfile；kDisabled=0 表示关闭
  atmospheric_physics:RirAtmosphericObservation;
}

// ---- session_config 载荷（root）----

table RirSessionConfig {
  hardware:RirHardwareConfig;
  orientation:RirAzimuthElevationLimitsDeg;
  mission:RirMissionConfig;
  policy:RirPolicyConfig;
  environment:RirEnvironmentConfig;
  sensor_enabled:bool;
  acceptance_log_enabled:bool = true;
}

root_type RirSessionConfig;
// v2（2026-08-30）：RirReceiverConfig 删除随迁未消费的 interference_observation_jn_gate_db
// （J/N 门观测是 AR 接收链语义，RIR 未立项），scene_polarization 槽位前移——与此前
// "RIRC" 载荷互不兼容，标识符升 RIRD 防静默误解码；项目未上线，无兼容分支。
// v3（2026-08-30）：RirTrackingPolicyConfig 删除全链未消费的 kalman_measurement_noise_std
// （RIR 量测噪声恒走 SNR 误差模型动态 R，缺省 R 回退永不触发），标识符升 RIRE；
// 项目未上线，无兼容分支。
// v4（2026-09-06）：RirSessionConfig sensor_platform_id 改名为 platform_id；
// 标识符升 RIRF；项目未上线，无兼容分支。
// v5（2026-09-06 RF 标识统一）：彻底删除 platform_id 及 transmitter/receiver equipment_id；
// 标识符升 RIRG；项目未上线，无兼容分支。
file_identifier "RIRG";

// ---- runtime_config_patch 载荷 ----

table RirRuntimeConfigPatch {
  has_mission:bool;
  mission:RirMissionConfig;
  has_work_mode:bool;
  work_mode:int;
  has_scan_center:bool;
  scan_center_deg:RirAzimuthElevationDeg;
  has_policy:bool;
  policy:RirPolicyConfig;
  has_environment:bool;
  environment:RirEnvironmentConfig;
  has_sensor_enabled:bool;
  sensor_enabled:bool;
  has_designated_target_id:bool;
  designated_external_target_id:ulong;
  has_designation_duration_cycles:bool;
  designation_duration_cycles:uint;
}

// ---- failure_marker 载荷 ----
// 字段与 AR / EOS 的 FailureMarker 一致，供回放结构化还原失败标记。

table RirFailureMarker {
  error_code:string;
  message:string;
  location:string;
  has_cycle_index:bool;
  cycle_index:uint;
  has_sim_time_sec:bool;
  sim_time_sec:double;
  diagnostics:string;
  has_last_event_sequence:bool;
  last_event_sequence:ulong;
}
