// sbirs_replay.fbs
// SBIRS-inspired replay FlatBuffers schema: cycle_input and cycle_output payloads.

namespace sbirs.replay;

struct Vec3d {
  x: double;
  y: double;
  z: double;
}

struct EulerDeg3d {
  yaw_deg: double;
  pitch_deg: double;
  roll_deg: double;
}

table SbirsSceneTarget {
  target_id: uint64;
  target_name: string;
  position_ecef_m: Vec3d;
  radiant_intensity_w_per_sr: double;
  velocity_ecef_m_per_s: Vec3d;
  has_velocity_ecef_m_per_s: bool;
  active: bool;
}

table SbirsCycleInput {
  cycle_index: uint32;
  dt_sec: float;
  utc_julian_day: double;
  satellite_position_ecef_m: Vec3d;
  satellite_velocity_ecef_m_per_s: Vec3d;
  satellite_attitude_eci_body_deg: EulerDeg3d;
  scene_targets: [SbirsSceneTarget];
}

root_type SbirsCycleInput;
// v2（2026-08 正式变更）：ECI 弧度输出 / 辐射强度签名 / UTC 儒略日；v1（"SBIC"，
// deg/ECEF 语义或无标识符）录制被显式拒绝。
// 2026-08-17 起周期输入新增必填卫星速度（ECEF）与必填卫星姿态（Z-Y-X 欧拉角，
// Body->ECI）。
// v3（2026-08-24）：必填卫星字段去 has_* 在场标志，表槽位前移——与 v2 载荷互不
// 兼容，标识符升 SBI3 防静默误解码；项目未上线，无兼容分支。
// v4（2026-09-02）：会话配置表删 max_concurrent_nfov_locks（单镜筒化）；标识符为
// 全 SBIRS 载荷共享常量，随之中段变更整体升 SBI4。
// v5（2026-09-07）：SbirsDetectionRecord 增加 measurement_time_s 测量绝对时刻（秒）；
// 标识符为全 SBIRS 载荷共享常量，随之中段变更整体升 SBI5。
file_identifier "SBI5";

table SbirsDetectionRecord {
  detection_id: uint64;
  azimuth_rad: float;
  elevation_rad: float;
  infrared_snr_linear: float;
  observation_stage: int32;
  detected: bool;
  measurement_time_s: double;
}

table SbirsDetectionAttributionRecord {
  detection_id: uint64;
  target_id: uint64;
  target_name: string;
  estimated_range_m: float;
  max_detection_range_m: float;
  tracking_source: int32;
  capture_failure_reason: int32;
  has_estimation_nis: bool;
  estimation_nis: float;
  estimation_nis_gate_exceeded: bool;
  nfov_channel_id: int32;
  has_nfov_tracking_diagnostics: bool;
  nfov_pointing_error_deg: float;
  nfov_geometry_gate_passed: bool;
  nfov_snr_gate_passed: bool;
  nfov_tracking_gate_failure_count: uint32;
  nfov_tracking_coasting: bool;
}

table SbirsOutputFrame {
  cycle_index: uint32;
  scan_azimuth_rad: float;
  scan_elevation_rad: float = 0.0;
  detections: [SbirsDetectionRecord];
}

// 统一问题列表模型（session_contract.md 规则 14）：单一 SbirsIssue 列表承载
// 输入校验问题（phase=kInputValidation）与执行诊断（phase=kExecution）。

table SbirsIssue {
  severity:      int32;
  phase:         int32;
  code:          string;
  message:       string;
  location_kind: int32 = 0;
  entity_index:  int64 = -1;
  field:         string;
  cause:         int32;
}

table SbirsCycleResult {
  input_cycle_index: uint32;
  output_frame: SbirsOutputFrame;
  detection_attributions: [SbirsDetectionAttributionRecord];
  abort_reason: int32;
  status: uint8;
  issues: [SbirsIssue];
}

table FailureMarker {
  error_code: string;
  message: string;
  location: string;
  has_cycle_index: bool;
  cycle_index: uint32;
  has_sim_time_sec: bool;
  sim_time_sec: double;
  diagnostics: string;
  has_last_event_sequence: bool;
  last_event_sequence: uint64;
}
